<tr>
  <td class="px" style="padding:36px 40px 8px;font-family:Arial,Helvetica,sans-serif;">
    <h1 class="h1" style="margin:0;font-size:28px;line-height:36px;color:#1F3A5F;font-weight:bold;">Your booking is confirmed!</h1>
  </td>
</tr>
<tr>
  <td class="px" style="padding:12px 40px 24px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:#333333;">
    <p style="margin:0 0 16px;">Hello {{name}},</p>
    <p style="margin:0;">Your booking has been successfully placed. Here are the booking details:</p>
  </td>
</tr>
<tr>
  <td class="px" style="padding:0 40px 28px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F4F6F9;border-left:4px solid #F28C28;border-radius:4px;">
      <tr>
        <td style="padding:18px 20px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#333333;">
          <strong style="color:#1F3A5F;">Booking details</strong><br>
          Booking ID: <strong>{{bookingId}}</strong><br>
          Check-in: <strong>{{checkIn}}</strong><br>
          Check-out: <strong>{{checkOut}}</strong><br>
          Pet name(s): <strong>{{petnames}}</strong>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td class="px" style="padding:0 40px 32px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:#333333;">
    <p style="margin:0;">Thank you for booking with House of Boarding. We look forward to hosting you and your pet!</p>
  </td>
</tr>
